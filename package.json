{
  "name": "@snapshot-site/mcp",
  "version": "0.1.1",
  "description": "Official MCP server for the Snapshot Site API — screenshots, visual diff, and AI webpage analysis for Claude, Cursor, ChatGPT, and MCP-compatible clients.",
  "homepage": "https://snapshot-site.com/mcp-server",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snapshot-site/snapshot-site-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/snapshot-site/snapshot-site-mcp/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "snapshot",
    "screenshot",
    "screenshot-api",
    "visual-diff",
    "visual-regression",
    "ai-agents",
    "claude",
    "api"
  ],
  "license": "MIT",
  "author": "Snapshot Site",
  "type": "module",
  "main": "build/server.js",
  "files": [
    "build",
    "README.md",
    "Dockerfile"
  ],
  "bin": {
    "snapshot-site-mcp": "build/server.js",
    "snapshot-site-mcp-http": "build/http.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "prepare": "pnpm run build",
    "test": "pnpm run build",
    "start": "node build/server.js",
    "start:http": "node build/http.js",
    "prepublishOnly": "pnpm run clean && pnpm run build"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@snapshot-site/sdk": "^0.1.0",
    "jose": "^6.1.0",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
