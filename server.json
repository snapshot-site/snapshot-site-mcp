{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "com.snapshot-site/screenshots",
  "title": "Snapshot Site",
  "description": "Capture screenshots, detect visual regressions between page versions, and analyze with AI.",
  "version": "0.1.4",
  "websiteUrl": "https://snapshot-site.com/mcp-server",
  "repository": {
    "url": "https://github.com/snapshot-site/snapshot-site-mcp",
    "source": "github",
    "id": "1196554224"
  },
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "@snapshot-site/mcp",
      "version": "0.1.4",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "name": "SNAPSHOT_SITE_API_KEY",
          "description": "Snapshot Site API key",
          "isRequired": true,
          "isSecret": true,
          "format": "string"
        }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.snapshot-site.com/mcp"
    }
  ]
}
